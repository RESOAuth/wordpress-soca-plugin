<?xml version="1.0"?>
<psalm xmlns="https://getpsalm.org/schema/config"
       errorLevel="1"
       phpVersion="8.1"
       resolveFromConfigFile="true"
       autoloader="autoload.php">
    <projectFiles>
        <directory name="../../simple-oauth-cimd-access"/>
        <ignoreFiles>
            <directory name="../../simple-oauth-cimd-access/vendor"/>
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="PsalmWordPress\Plugin"/>
        <pluginClass class="SOCA\Security\PsalmTaintPlugin"/>
    </plugins>
</psalm>
